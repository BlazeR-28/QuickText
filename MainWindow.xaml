<Window x:Class="QuickText.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="QuickText" Icon="Resources/quicktext.ico"
        Width="520" Height="280" MinWidth="360" MinHeight="180"
        WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource BgBrush}"
        Topmost="True" ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="{StaticResource UiFont}">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="6"
                            GlassFrameThickness="0" CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header: the empty area is the drag handle -->
        <Grid Grid.Row="0" Margin="18,0,8,0">
            <!-- Brand mark: a text-cursor bar in the accent colour, followed by the name -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" IsHitTestVisible="False">
                <Rectangle Width="3" Height="14" RadiusX="1" RadiusY="1" Fill="{StaticResource AccentBrush}"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Text="QuickText" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource FgSoftBrush}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="SettingsBtn" Style="{StaticResource IconButton}" Content="&#xE713;"
                        ToolTip="Settings" AutomationProperties.Name="Settings"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                <Button x:Name="CloseBtn" Style="{StaticResource IconButton}" Content="&#xE921;"
                        AutomationProperties.Name="Hide window" Margin="2,0,0,0" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
            </StackPanel>
        </Grid>

        <!-- Editor -->
        <Grid Grid.Row="1" Margin="0,0,6,0">
            <TextBox x:Name="Pad" Style="{StaticResource PadStyle}"
                     Background="Transparent" BorderThickness="0"
                     Foreground="{StaticResource FgBrush}"
                     CaretBrush="{StaticResource AccentBrush}"
                     SelectionBrush="{StaticResource AccentBrush}" SelectionOpacity="0.35"
                     IsInactiveSelectionHighlightEnabled="True"
                     FontSize="14" TextWrapping="Wrap" AcceptsReturn="True" AcceptsTab="True"
                     SpellCheck.IsEnabled="True" Padding="8,2,8,4"
                     TextBlock.LineHeight="21" TextBlock.LineStackingStrategy="BlockLineHeight"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"/>
            <!-- Empty-note placeholder doubles as the "how do I get this window back" hint -->
            <StackPanel Margin="23,2,8,0" IsHitTestVisible="False" VerticalAlignment="Top">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Text.Length, ElementName=Pad}" Value="0">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <!-- Same line height as the editor, so the text is centered on the caret -->
                <TextBlock Text="Start typing..." FontSize="14" Foreground="{StaticResource FaintBrush}"
                           LineHeight="21" LineStackingStrategy="BlockLineHeight"/>
                <TextBlock x:Name="HintLabel" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"
                           Foreground="{StaticResource MutedBrush}"/>
            </StackPanel>
        </Grid>

        <!-- Footer: link pills left, actions right -->
        <Grid Grid.Row="2" Margin="18,6,16,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <WrapPanel x:Name="PillPanel" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,-4"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                <Button x:Name="ClearBtn" Style="{StaticResource ChipButton}" Content="Clear"
                        ToolTip="Clear the note (Ctrl+Z brings it back)" MinWidth="64"/>
                <Button x:Name="CopyBtn" Style="{StaticResource PrimaryButton}" Content="Copy"
                        ToolTip="Copy the whole note" Margin="8,0,0,0" MinWidth="72"/>
            </StackPanel>
        </Grid>

        <!-- Settings overlay -->
        <Grid x:Name="SettingsPanel" Grid.Row="1" Grid.RowSpan="2" Visibility="Collapsed"
              Background="{StaticResource PanelBrush}" Focusable="True">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="22,6,22,18">

                    <TextBlock Text="Settings" FontSize="15" FontWeight="SemiBold"
                               Foreground="{StaticResource FgBrush}" Margin="0,0,0,14"/>

                    <Grid Margin="0,0,0,16">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Autosave and restore" FontSize="13" Foreground="{StaticResource FgBrush}"/>
                            <TextBlock Text="Keeps your note after closing the app" FontSize="11"
                                       Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <CheckBox x:Name="AutosaveSwitch" Style="{StaticResource Switch}" HorizontalAlignment="Right"/>
                    </Grid>

                    <Grid Margin="0,0,0,16">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Start with Windows" FontSize="13" Foreground="{StaticResource FgBrush}"/>
                            <TextBlock Text="Runs quietly in the tray after you sign in" FontSize="11"
                                       Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <CheckBox x:Name="AutostartSwitch" Style="{StaticResource Switch}" HorizontalAlignment="Right"/>
                    </Grid>

                    <Grid Margin="0,0,0,4">
                        <TextBlock Text="Opacity" FontSize="13" Foreground="{StaticResource FgBrush}"/>
                        <TextBlock x:Name="OpacityLabel" Text="100%" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Right"/>
                    </Grid>
                    <Slider x:Name="OpacitySlider" Minimum="0" Maximum="100" Margin="0,0,0,18"/>

                    <TextBlock Text="SHORTCUTS" FontSize="10" FontWeight="SemiBold"
                               Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8"/>
                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="Copy note" FontSize="13" VerticalAlignment="Center" Foreground="{StaticResource FgBrush}"/>
                        <Button x:Name="CopyKeyBtn" Tag="Copy" Style="{StaticResource HotkeyButton}" HorizontalAlignment="Right"/>
                    </Grid>
                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="Hide window" FontSize="13" VerticalAlignment="Center" Foreground="{StaticResource FgBrush}"/>
                        <Button x:Name="CloseKeyBtn" Tag="Close" Style="{StaticResource HotkeyButton}" HorizontalAlignment="Right"/>
                    </Grid>
                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="Exit QuickText" FontSize="13" VerticalAlignment="Center" Foreground="{StaticResource FgBrush}"/>
                        <Button x:Name="ExitKeyBtn" Tag="Exit" Style="{StaticResource HotkeyButton}" HorizontalAlignment="Right"/>
                    </Grid>
                    <Grid Margin="0,0,0,6">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Show / hide from anywhere" FontSize="13" Foreground="{StaticResource FgBrush}"/>
                            <TextBlock Text="Works in every app. Left-click on the tray icon does the same." FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Button x:Name="GlobalKeyBtn" Tag="Global" Style="{StaticResource HotkeyButton}" HorizontalAlignment="Right"/>
                    </Grid>
                    <TextBlock x:Name="HotkeyError" FontSize="11" TextWrapping="Wrap"
                               Foreground="{StaticResource DangerBrush}" Margin="0,2,0,0"/>
                    <TextBlock Text="Click a field, then press the keys. Backspace clears it."
                               FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,18"/>

                    <Grid>
                        <Button x:Name="ExitAppBtn" Style="{StaticResource DangerButton}" Content="Exit QuickText"
                                HorizontalAlignment="Left"/>
                        <Button x:Name="DoneBtn" Style="{StaticResource PrimaryButton}" Content="Done"
                                HorizontalAlignment="Right" MinWidth="80"/>
                    </Grid>
                    <TextBlock x:Name="AboutLabel" FontSize="10" Foreground="{StaticResource FaintBrush}"
                               HorizontalAlignment="Center" Margin="0,18,0,0"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
